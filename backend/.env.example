# Backend local settings. Copy to backend/.env and edit the values.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Windows: COM5 / COM6 ... ; Linux: /dev/ttyACM0 or /dev/ttyUSB0
HONEY_SERIAL_PORT=COM5
HONEY_SERIAL_BAUD=9600
HONEY_SCAN_TIMEOUT_SECONDS=45
HONEY_SERIAL_RESET_DELAY_SECONDS=2
HONEY_UV_UNIT=raw_or_voltage
# Optional; defaults to python on Windows and python3 on Linux.
# HONEY_PYTHON_EXECUTABLE=python
