# Backend
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://honey_admin:CHANGE_ME@localhost:5432/honey_quality?schema=public

# Real Arduino serial hardware (required to start a physical scan)
HARDWARE_MODE=serial
SERIAL_PORT=COM5
SERIAL_BAUD_RATE=9600
HARDWARE_PYTHON=python
HARDWARE_SCAN_SECONDS=23
HARDWARE_TIMEOUT_MS=45000
# Leave unset until measured with a multimeter / confirmed from the actual wiring.
ADC_REFERENCE_VOLTAGE=
ADC_MAX_VALUE=1023

# Replace every placeholder before deployment.
POSTGRES_USER=honey_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
POSTGRES_DB=honey_quality
