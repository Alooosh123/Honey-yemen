generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HardwareMeasurement {
  id             String   @id
  batchNumber    String   @db.VarChar(80)
  barcode        String   @unique @db.VarChar(32)
  testedAt       DateTime
  analysisStatus String   @default("NOT_EVALUATED") @db.VarChar(32)
  record         Json
  createdAt      DateTime @default(now())

  @@index([batchNumber])
  @@index([testedAt])
}
