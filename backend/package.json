{
  "name": "honey-backend",
  "version": "1.0.0",
  "description": "Honey Quality Assessment System Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prestart": "npm run prisma:generate && npm run prisma:migrate:deploy && npm run build",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "predev": "npm run prisma:generate && npm run prisma:migrate:deploy"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.33.2",
    "@prisma/client": "^5.9.1",
    "@tensorflow/tfjs": "^4.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "long": "^5.3.2",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.7.4",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/pdfkit": "^0.13.3",
    "prisma": "^5.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
